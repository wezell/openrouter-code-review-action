diff --git a/core-web/libs/dotcms-webcomponents/src/global/global.scss b/core-web/libs/dotcms-webcomponents/src/global/global.scss
new file mode 100644
index 000000000000..f4423a9450c8
--- /dev/null
+++ b/core-web/libs/dotcms-webcomponents/src/global/global.scss
@@ -0,0 +1,13 @@
+// Global styles injected into every component of the dotcms-webcomponents lib.
+//
+// @material/mwc-icon renders icons inside shadow DOM with
+// `font-family: var(--mdc-icon-font, 'Material Icons')`. Overriding
+// `--mdc-icon-font` at :root lets every mwc-icon pick up the Material
+// Symbols font without changing any component markup.
+//
+// The consuming app (dotcms-ui) is responsible for loading the
+// `Material Symbols Outlined` font face (see
+// `libs/dotcms-scss/shared/_material-symbols-outlined.scss`).
+:root {
+    --mdc-icon-font: "Material Symbols Outlined";
+}
